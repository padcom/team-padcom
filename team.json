      "allow": [
        "Bash(git clone /home/padcom/projects/padcom-team/repos/* /home/padcom/projects/padcom-team/workspaces/developer/*)",
        "Bash(git clone --depth 1 * https://github.com/ArduPilot/ardupilot.git /home/padcom/projects/padcom-team/shared/tools/*)",
        "Bash(bash .github/*)",
        "Bash(/home/padcom/projects/padcom-team/shared/tools/venv-ardupilot/bin/python *)",
        "Bash(/home/padcom/projects/padcom-team/shared/tools/venv-ardupilot/bin/pip *)",

        "Bash(git fetch *)",
        "Bash(git checkout *)",
        "Bash(git submodule *)",
        "Bash(gh pr create*)",
        "Bash(gh run view*)",
        "Bash(gh run list*)",
        "Bash(gh run watch*)",
        "Bash(gh workflow view*)",
        "Bash(gh workflow list*)",
        "Bash(git ls-remote*)",
        "Bash(mkdir *)",
        "Bash(python3 *)",
        "Bash(dpkg-query *)",
        "Bash(./shared/ *)",
        "Bash(./waf *)",
        "Bash(pnpm *)",

        "Bash(git clone --depth 1 * https://github.com/ArduPilot/ardupilot.git ./shared/tools/*)",
        "Bash(./shared/tools/venv-ardupilot/bin/python *)",
        "Bash(./shared/tools/venv-ardupilot/bin/pip *)",
        "Bash(env SITL_BINARY=*)",

        "Bash(ls -la /tmp/sitl-locks)",
        "Bash(ls -la /tmp/sitl-locks/*)",
        "Bash(ls /tmp/sitl-locks)",
        "Bash(ls /tmp/sitl-locks/*)",
        "Read(//tmp/sitl-locks/**)"
      ]
    },
    "reviewer": {
      "model": "sonnet",
      "capabilities": [
        "worktree",
        "comment"
      ],
      "allow": [
        "Bash(gh run view*)",
        "Bash(gh run list*)",
        "Bash(gh run watch*)",
        "Bash(gh workflow view*)",
        "Bash(gh workflow list*)",
        "Bash(git ls-remote*)"
      ]
    },
    "qa": {
      "model": "haiku",
      "capabilities": [
        "worktree",
        "tests",
        "comment"
      ],
      "env": {
        "SITL_BINARY": "/home/padcom/projects/padcom-team/shared/tools/ardupilot/build/sitl/bin/arducopter"
      },
      "allow": [
        "Bash(git clone /home/padcom/projects/padcom-team/repos/* /home/padcom/projects/padcom-team/workspaces/qa/*)",
        "Bash(git checkout*)",
        "Bash(git switch*)",
        "Bash(git pull*)",
        "Bash(git stash*)",
        "Bash(git cherry-pick*)",
        "Bash(git rebase origin/*)",
        "Bash(bash .github/*)",

        "Bash(command -v *)",
        "Bash(ls * /tmp/*)",
        "Bash(pgrep*)",

        "Bash(gh run view*)",
        "Bash(gh run list*)",
        "Bash(gh run watch*)",
        "Bash(gh workflow view*)",
        "Bash(gh workflow list*)",

        "Bash(ls -la /tmp/sitl-locks)",
        "Bash(ls -la /tmp/sitl-locks/*)",
        "Bash(ls /tmp/sitl-locks)",
        "Bash(ls /tmp/sitl-locks/*)",
        "Read(//tmp/sitl-locks/**)"
      ]
    }
