{
  "serviceName": "padcom-team",
  "license": "MIT",
  "channel": "plugin:discord@claude-plugins-official",
  "allow": [
    "Bash(grep*)",
    "Bash(head*)",
    "Bash(tail*)",
    "Bash(git ls-remote*)"
  ],
  "permissionSets": {
    "gh-read": [
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh repo view*)"
    ],
    "gh-pr-create": [
      "Bash(gh pr create*)"
    ],
    "gh-issue": [
      "Bash(gh issue create*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue close*)",
      "Bash(gh issue reopen*)",
      "Bash(gh issue edit*)"
    ],
    "gh-pr": [
      "Bash(gh pr comment*)",
      "Bash(gh pr close*)"
    ],
    "gh-label": [
      "Bash(gh label create*)"
    ],
    "gh-run": [
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(gh run watch*)",
      "Bash(gh run rerun*)",
      "Bash(gh run cancel*)"
    ],
    "gh-workflow": [
      "Bash(gh workflow view*)",
      "Bash(gh workflow list*)"
    ]
  },
  "roles": {
    "lead": {
      "model": "sonnet",
      "channel": true,
      "capabilities": [
        "editShared",
        "merge"
      ],
      "permissionSets": [
        "gh-issue",
        "gh-label",
        "gh-pr",
        "gh-read",
        "gh-run",
        "gh-workflow"
      ]
    },
    "architect": {
      "model": "sonnet",
      "capabilities": [
        "editShared"
      ],
      "permissionSets": [
        "gh-read"
      ]
    },
    "developer": {
      "model": "sonnet",
      "capabilities": [
        "commit",
        "push",
        "tests",
        "worktree"
      ],
      "permissionSets": [
        "gh-pr",
        "gh-pr-create",
        "gh-read",
        "gh-run",
        "gh-workflow"
      ],
      "allow": [
        "Bash(bash .github/*)",
        "Bash(dpkg-query *)",
        "Bash(git checkout *)",
        "Bash(git cherry-pick *)",
        "Bash(git clone ${TEAM_ROOT}/repos/* ${TEAM_ROOT}/workspaces/developer/*)",
        "Bash(git fetch *)",
        "Bash(git rebase origin/*)",
        "Bash(git submodule *)",
        "Bash(mkdir *)",
        "Bash(pnpm *)",
        "Bash(python3 *)"
      ]
    },
    "reviewer": {
      "model": "sonnet",
      "capabilities": [
        "worktree"
      ],
      "permissionSets": [
        "gh-issue",
        "gh-pr",
        "gh-read",
        "gh-run",
        "gh-workflow"
      ]
    },
    "qa": {
      "model": "haiku",
      "capabilities": [
        "tests",
        "worktree"
      ],
      "permissionSets": [
        "gh-issue",
        "gh-pr",
        "gh-read",
        "gh-run",
        "gh-workflow"
      ],
      "allow": [
        "Bash(bash .github/*)",
        "Bash(command -v *)",
        "Bash(git checkout*)",
        "Bash(git cherry-pick*)",
        "Bash(git clone ${TEAM_ROOT}/repos/* ${TEAM_ROOT}/workspaces/qa/*)",
        "Bash(git pull*)",
        "Bash(git rebase origin/*)",
        "Bash(git stash*)",
        "Bash(git switch*)",
        "Bash(ls * /tmp/*)"
      ]
    }
  },
  "testCommands": [
    "npm ci*",
    "npm install*",
    "npm test*",
    "npm run test*",
    "npm run lint*",
    "npm run build*",
    "npx vitest*",
    "npx tsc*",
    "node --test*",
    "node scripts/*",
    "node --version",
    "npm run*",
    "npx --no-install*",
    "pytest*",
    "python3 -m pytest*",
    "pnpm install*",
    "pnpm test*",
    "pnpm run*",
    "pnpm exec*",
    "pnpm e2e*",
    "pnpm build*",
    "pnpm lint*",
    "pnpm typecheck*",
    "pnpm check*",
    "pnpm --filter*",
    "pnpm -r*",
    "pnpm -w*",
    "pnpm dlx*",
    "pnpm vitest*",
    "pnpm tsc*",
    "cmake *",
    "ctest*",
    "make*",
    "cargo test*",
    "cargo build*",
    "cargo clippy*",
    "go test*",
    "go build*",
    "python3 -m venv*",
    "cargo fmt*"
  ]
}
